# Key pool: add at least two keys. They are tried in numeric order.
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_KEY_1=
LLM_KEY_2=

# Optional per-key overrides, for mixing models or providers:
# LLM_MODEL_2=groq/openai/gpt-oss-20b
# LLM_API_BASE_2=https://your-openai-compatible-host/v1

# Storage
DATABASE_URL=sqlite:////data/app.db

# Response cache: disk or local (in-memory)
CACHE_ENABLED=true
CACHE_TYPE=disk
CACHE_DIR=/data/llm-cache
CACHE_TTL_SECONDS=86400

# Failover test hook (X-Simulate-Failure). Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# Comma-separated frontend origins allowed by the backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend URL compiled into the frontend
VITE_API_BASE_URL=http://localhost:8000

# Optional tuning
# DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# LLM_TIMEOUT_SECONDS=25
# LLM_MAX_OUTPUT_TOKENS=2048
# MAX_HISTORY_MESSAGES=100
